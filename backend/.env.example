# Configurações do Ambiente - Projeto Jovem Protagonista Backend
ENVIRONMENT=development
PROJECT_NAME="Projeto Jovem Protagonista"
API_V1_PREFIX="/api/v1"

# Banco de Dados PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jovem_protagonista_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jovem_protagonista_db

# Segurança e Autenticação
SECRET_KEY=change_this_to_a_super_secret_key_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
SECRET_BOARDING_KEY=secret_boarding_hmac_key_for_qr_codes

# Configurações de Reserva e Negócio
BOOKING_EXPIRATION_MINUTES=15
