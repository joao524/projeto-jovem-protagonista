# ========================================
# Projeto Jovem Protagonista — .gitignore
# ========================================

# ─── Python / Backend ───────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json

# Alembic compiled
backend/alembic/versions/*.pyc

# ─── Node / Frontend ────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Secrets & Environment ──────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Keep the example file
!.env.example
!backend/.env.example

# ─── IDE / OS ───────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ─── Database ───────────────────────────
*.db
*.sqlite
*.sqlite3
postgres-data/

# ─── Misc ───────────────────────────────
*.log
*.pid
*.seed
*.pid.lock
